% --- Document: Commands ---
{%- raw %}
% Separator: \sep
\newcommand{\sep}{\vspace{-0.75em}\hrule\vspace{1em}}

% Section: \sec{Label}
\newcommand{\fsec}[1]{\vspace{-1.25em}\section*{#1}\sep}

% Occupation: \occupation{Work}
\newcommand{\occupation}[1]{\decoicon{\faSuitcase}\hspace{0.25em}#1}

% Decorative icon with empty ActualText, so copy/paste and ATS parsers skip
% its glyph name ("Envelope", "Phone", ...): \decoicon{\faEnvelope}
\newcommand{\decoicon}[1]{\BeginAccSupp{method=escape,ActualText={}}#1\EndAccSupp{}}

% Contact item, kept on one line: \contactitem{icon}{content}
\newcommand{\contactitem}[2]{\mbox{\decoicon{#1}\hspace{0.3em}#2}}

% Location: \location{State, Country}
\newcommand{\location}[1]{\contactitem{\faMapMarker*}{#1}}

% Phone: \phone{tel:+5512912345678}{+55 12 91234-5678}
\newcommand{\phone}[2]{\contactitem{\faPhone}{\href{#1}{#2}}}

% Email: \email{something@provider.com}
\newcommand{\email}[1]{\contactitem{\faEnvelope}{\href{mailto:#1}{\nolinkurl{#1}}}}

% Website: \website{https://example.com}{example.com}
\newcommand{\website}[2]{\contactitem{\faGlobe}{\href{#1}{\nolinkurl{#2}}}}

% Github: \github{user}
\newcommand{\github}[1]{\contactitem{\faGithub}{\href{https://github.com/#1}{\nolinkurl{github.com/#1}}}}

% LinkedIn: \linkedin{user}
\newcommand{\linkedin}[1]{\contactitem{\faLinkedin}{\href{https://linkedin.com/in/#1}{\nolinkurl{linkedin.com/in/#1}}}}

% Topics: \topic{example}{text}
\newcommand{\topic}[2]{\textbf{#1:} #2}

% Experience: \experience{contractor}{position}{location}{start}{end}{details}
\newcommand{\experience}[6]{
    \noindent\textbf{#1} \hfill #3 \\
    \noindent#2 \hfill #4 -- #5
    \ifblank{#6}{}{
    \begin{itemize}[align=right]
        #6
    \end{itemize}
    }
    \vspace{1em}
}

% Project: \project{title}{language}{details}
\newcommand{\project}[3]{
    \noindent\textbf{#1}\ifstrempty{#2}{}{ \textit{(#2)}}
    \begin{itemize}[align=right]
        #3
    \end{itemize}
    \vspace{1em}
}

% Proficiency: \proficiency{language}{methodology}{score}{validation number}
\newcommand{\proficiency}[4]{
    \textbf{#1\ifstrempty{#2}{:}{ \textit(#2):}} #3 \hfill #4
}

% Education: \education{name}{location}{type}{start}{end}
\newcommand{\education}[6]{
    \textbf{#1} -- #3\hfill{#2}\\
    #4\hfill#5 -- #6
}

{% endraw -%}
% --- Document: Start ---
\begin{document}
% Alignment
\raggedright

% Name and Occupation
\begin{center}
    {\huge \textbf{ {{- config.identity.get_full_name(shorten=config.identity.shorten_name) | upper -}} }}
    \vspace{0.25em}

    {\Large {{ profile.name -}} }
{%- set contact = config.identity.contact %}
{%- if contact %}
    \vspace{0.5em}

    {% set sep = joiner(" \\quad ") %}
    {\small
    {%- if contact.location %} {{ sep() }}\location{ {{- contact.location -}} }{% endif %}
    {%- if contact.phone %} {{ sep() }}\phone{ {{- contact.phone_uri() -}} }{ {{- contact.phone -}} }{% endif %}
    {%- if contact.email %} {{ sep() }}\email{ {{- contact.email -}} }{% endif %}
    {%- if contact.website %} {{ sep() }}\website{ {{- contact.website_url() -}} }{ {{- contact.website_label() -}} }{% endif %}
    {%- if contact.github %} {{ sep() }}\github{ {{- contact.github_handle() -}} }{% endif %}
    {%- if contact.linkedin %} {{ sep() }}\linkedin{ {{- contact.linkedin_handle() -}} }{% endif %}
    }
{%- endif %}
\end{center}
\vspace{-0.5em}

{% if profile.skills %}
% Skills
\fsec{ {{- config.get_override("skills") | default("Skills", true) -}} }
{%- for skill in profile.skills %}
    \topic{ {{- skill.scope -}} }{ {{- ", ".join(skill.values) -}} }
{% endfor %}{% endif %}

{% if profile.language %}
% Language Proficiency
\fsec{ {{- config.get_override("languages") | default("Languages", true) -}} }

{%- for language in profile.language %}
    \proficiency{
        {{- language.name -}}
    }{
        {{- language.test if language.test -}}
    }{
        {{- language.level -}}
    }{
        {%- if language.test_registration -%}
        \textbf{ {{- language.test_registration -}} :} {{ language.test_code -}}
        {%- endif -%}
    }
{% endfor %}{% endif %}

{% if profile.experience %}
% Professional Experience
\fsec{ {{- config.get_override("experience") | default("Professional Experience", true) -}} }
{%- for experience in profile.experience %}
    \experience{
        {{- experience.at -}}
    }{
        {{- experience.role -}}
    }{
        {{- experience.location if experience.location -}}
    }{
        {{- experience.start -}}
    }{
        {{- experience.end if experience.end -}}
    }{
        {%- for action in experience.actions or [] %}
        \item {{ action }}
        {%- endfor %}
    }
{% endfor %}{% endif %}

{% if profile.project %}
% Projects
\fsec{ {{- config.get_override("projects") | default("Projects", true) -}} }
{%- for project in profile.project %}
    \project{ {{- project.name -}} }{ {{- project.language if project.language -}} }{
        {%- for detail in project.details %}
        \item {{ detail }}
        {%- endfor %}
    }
{% endfor %}{% endif %}

{% if profile.education %}
% Education
\fsec{ {{- config.get_override("education") | default("Education", true) -}} }
{%- for education in profile.education %}
    \education{ {{- education.institution -}} }{ {{- education.location -}} }
        { {{- education.course -}} }{ {{- education.level -}} }
        { {{- education.start -}} }{ {{- education.end -}} }
{% endfor %}{% endif %}
% --- Document: End ---
\end{document}

